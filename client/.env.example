# Copy to .env.local and fill in. .env / .env.local are gitignored — never
# commit real values, and keep machine-specific hostnames out of this file.

# Google OAuth web client id, from the Firebase console for the environment
# you are building against.
EXPO_PUBLIC_WEB_CLIENT_ID=

# development | preview | production. Read by app.config.ts at build time.
APP_ENV=development


# --- Local Firebase emulator suite ----------------------------------------
#
# Opt in to the emulators. This flag alone is not sufficient: APP_ENV must be
# development and the build must be a debug build. See resolveBackendMode()
# in firebase/environment.ts.
EXPO_PUBLIC_USE_EMULATOR=true

# The host the emulators are reachable at *from the device running the app*:
#
#   iOS simulator / Android emulator, same machine  ->  localhost
#   Physical device on the same Wi-Fi               ->  your machine's LAN IP
#   Physical device anywhere (what we use)          ->  Tailscale MagicDNS name
#
# We run the emulators over Tailscale so a physical device can reach them
# without sharing a network. Get your machine's name with `tailscale status`;
# it looks like `<machine>-<suffix>.<tailnet>.ts.net`.
#
# Two things depend on this being set correctly:
#
#  1. app.config.ts bakes an ATS exception domain for this exact host into the
#     iOS Info.plist. Tailscale addresses live in the 100.64.0.0/10 CGNAT
#     range, which iOS does NOT count as local networking, so
#     NSAllowsLocalNetworking alone will not permit cleartext to it.
#  2. Because that happens at prebuild, changing this value requires a native
#     rebuild (`npx expo run:ios`), not just a Metro restart.
#
# ANDROID: not supported for emulator work yet. The ATS exception above is
# iOS-only, and Android 9+ blocks cleartext HTTP by default — there is no
# android.usesCleartextTraffic in the expo-build-properties config and no
# network security config, so a physical Android device cannot reach the
# emulators over Tailscale. Use iOS or a simulator.
#
EXPO_PUBLIC_EMULATOR_HOST=your-machine.your-tailnet.ts.net

# Metro must advertise the same reachable hostname, or the device resolves the
# emulators fine but still cannot download the JS bundle.
REACT_NATIVE_PACKAGER_HOSTNAME=your-machine.your-tailnet.ts.net


# --- Optional -------------------------------------------------------------
# Overrides Firebase project id resolution (see resolveProjectId in
# firebase/environment.ts). Leave unset unless you know you need it.
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
