rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get, list:
        if request.auth != null && request.auth.uid == userId;
      // `status` and `deletedAt` are only set by the server when an account is
      // deleted. Clients can't set them, or a user could mark themselves deleted
      // to forfeit instead of taking a loss.
      allow create:
        if request.auth != null && request.auth.uid == userId &&
          !request.resource.data.keys().hasAny(['status', 'deletedAt']);
      allow update:
        if request.auth != null && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['status', 'deletedAt']);
      allow delete:
        if false;
    }

    match /users/{userId}/teams/{teamId} {
      allow get, list:
        if request.auth != null && request.auth.uid == userId;
      allow write:
        if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasAll(['abbreviation', 'logoUrl', 'name']);
    }

    match /nbaPlayers/{playerId} {
      allow read:
        if request.auth != null;
    }

    match /nbaPlayerAverages/{playerId} {
      allow read:
        if request.auth != null;
    }

    match /nbaTeams/{teamId} {
      allow read:
        if request.auth != null;
    }

    match /augments/{augmentId} {
      allow read:
        if request.auth != null;
      allow write:
        if request.auth != null;
    }

    match /matchups/{matchupId} {
      allow read:
        if request.auth != null;
      allow write:
        if false;
    }

    match /leagues/{leagueId} {
      allow read:
        if request.auth != null;
      allow write:
        if false;
    }

    match /leagues/{leagueId}/members/{memberId} {
      allow read:
        if request.auth != null;
      allow write:
        if false;
    }
  }
}
