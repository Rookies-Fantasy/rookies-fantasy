rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow get, list:
        if request.auth != null && request.auth.uid == userId;
      allow create, update:
        if request.auth != null && request.auth.uid == userId;
      allow delete:
        if false;
    }

    match /users/{userId}/teams/{teamId} {
      allow get, list:
        if request.auth != null && request.auth.uid == userId;
      allow write:
        if request.auth != null &&
          request.auth.uid == userId &&
          request.resource.data.keys().hasAll(['abbreviation', 'logoUrl', 'name']);
    }

    match /nbaPlayers/{playerId} {
      allow read:
        if request.auth != null;
    }

    match /nbaPlayerAverages/{playerId} {
      allow read:
        if request.auth != null;
    }

    match /nbaTeams/{teamId} {
      allow read:
        if request.auth != null;
    }

    match /augments/{augmentId} {
      allow read:
        if request.auth != null;
      allow write:
        if request.auth != null;
    }

    match /matchups/{matchupId} {
      allow read:
        if request.auth != null;
      allow write:
        if request.auth != null;
    }

    // Mirrors what the client does today: leagueController creates a league
    // with .add() and joins one by arrayUnion-ing onto teamIds/userIds in a
    // transaction, so client writes must stay allowed here or league create /
    // join breaks against the emulator while still working in dev.
    //
    // These write rules are deliberately permissive and are tightened in
    // ENG-146, which moves league mutations behind callable Cloud Functions
    // (Admin SDK writes bypass rules, so this becomes `if false` there).
    match /leagues/{leagueId} {
      allow read:
        if request.auth != null;
      allow write:
        if request.auth != null;
    }

    match /leagues/{leagueId}/members/{memberId} {
      allow read:
        if request.auth != null;
      allow write:
        if request.auth != null;
    }
  }
}
